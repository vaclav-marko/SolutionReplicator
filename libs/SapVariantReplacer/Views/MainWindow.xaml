<Window x:Class="SapVariantReplacer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SapVariantReplacer.ViewModels"
        Title="SAP Variant File Replacer"
        Width="1100" Height="780"
        MinWidth="800" MinHeight="580"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Highlight rows where the user changed a value -->
        <Style x:Key="ChangedRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                    <Setter Property="Background" Value="#FFFFF3CD" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Source folder -->
        <GroupBox Grid.Row="0" Header="Source Folder" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Margin="0,0,8,0" />
                <Button Grid.Column="1" Content="Browse…" Padding="12,4"
                        Command="{Binding BrowseSourceCommand}" Margin="0,0,8,0" />
                <Button Grid.Column="2" Content="Scan Files" Padding="16,4"
                        Command="{Binding ScanCommand}" />
            </Grid>
        </GroupBox>

        <!-- Row 1: Filter + Show Changed Only -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Filter:" VerticalAlignment="Center"
                       Margin="0,0,8,0" FontWeight="SemiBold" />
            <TextBox Grid.Column="1"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox Grid.Column="2" Content="Show changed only"
                      IsChecked="{Binding ShowChangedOnly}"
                      VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>

        <!-- Row 2: Search & Replace -->
        <GroupBox Grid.Row="2" Header="Search &amp; Replace in Values" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Search:" VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" />
                <TextBlock Grid.Column="2" Text="Replace:" VerticalAlignment="Center"
                           Margin="12,0,8,0" />
                <TextBox Grid.Column="3"
                         Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" />
                <Button Grid.Column="4" Content="Replace All" Padding="12,4" Margin="8,0,0,0"
                        Command="{Binding SearchReplaceCommand}" />
            </Grid>
        </GroupBox>

        <!-- Row 3: Column headers label -->
        <TextBlock Grid.Row="3" Margin="0,0,0,4" FontSize="11" Foreground="Gray">
            <Run Text="Edit the 'New Value' column. Right-click a row for bulk operations. Click column headers to sort." />
        </TextBlock>

        <!-- Row 4: DataGrid -->
        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding FieldEntriesView}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="True"
                  RowStyle="{StaticResource ChangedRowStyle}"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#FFF8F8F8"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  Margin="0,0,0,8">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem HeaderStringFormat="Set new value for all '{0}' rows"
                              Header="{Binding PlacementTarget.SelectedItem.FieldName,
                                       RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              Command="{Binding PlacementTarget.DataContext.BulkSetFieldValueCommand,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                 RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Modified" Binding="{Binding IsChanged, Mode=OneWay}"
                                        IsReadOnly="True" Width="70" />
                <DataGridTextColumn Header="Field Name" Binding="{Binding FieldName}"
                                    IsReadOnly="True" Width="200" />
                <DataGridTextColumn Header="Original Value" Binding="{Binding OriginalValue}"
                                    IsReadOnly="True" Width="260" />
                <DataGridTextColumn Header="New Value"
                                    Binding="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}"
                                    Width="260" />
                <DataGridTextColumn Header="Occurrences" Binding="{Binding OccurrenceCount}"
                                    IsReadOnly="True" Width="90" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Row 5: Output folder -->
        <GroupBox Grid.Row="5" Header="Output Folder" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Margin="0,0,8,0" />
                <Button Grid.Column="1" Content="Browse…" Padding="12,4"
                        Command="{Binding BrowseOutputCommand}" />
            </Grid>
        </GroupBox>

        <!-- Row 6: Options + Apply + Cancel -->
        <Grid Grid.Row="6" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" Content="Copy unmodified files to output folder"
                      IsChecked="{Binding CopyUnmodified}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Cancel" Padding="16,6" Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <Button Grid.Column="2" Content="Apply Changes" Padding="24,6"
                    Command="{Binding ApplyCommand}" FontWeight="SemiBold" FontSize="14" />
        </Grid>

        <!-- Row 7: Status bar + progress -->
        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                       VerticalAlignment="Center" Foreground="DarkSlateGray" />
            <ProgressBar Grid.Column="1" Minimum="0"
                         Maximum="{Binding ProgressMax}"
                         Value="{Binding ProgressValue}"
                         Height="18" Margin="8,0,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</Window>
