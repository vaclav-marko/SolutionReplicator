<Window x:Class="SolutionReplicator.Views.WizardShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SolutionReplicator.ViewModels"
        Title="SAP Solution Replicator"
        Width="1200" Height="820"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#FF2196F3" Padding="16,12">
            <TextBlock Text="{Binding HeaderText}" Foreground="White"
                       FontSize="16" FontWeight="SemiBold" />
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="#FFF0F0F0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="Cancel" Padding="18,6" Margin="0,0,8,0"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="2" Content="◀ Back" Padding="18,6" Margin="0,0,8,0"
                        Command="{Binding BackCommand}" />
                <Button Grid.Column="3" Content="Next ▶" Padding="22,6" FontWeight="SemiBold"
                        Command="{Binding NextCommand}" />
            </Grid>
        </Border>

        <!-- Step content -->
        <ContentControl Content="{Binding CurrentStep}" Margin="0" />
    </DockPanel>
</Window>
